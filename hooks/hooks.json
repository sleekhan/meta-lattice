{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/meta-lattice\" sync"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/meta-lattice\" sync && \"${CLAUDE_PLUGIN_ROOT}/meta-lattice\" audit"
          }
        ]
      }
    ]
  }
}
